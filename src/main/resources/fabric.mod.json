{
	"schemaVersion": 1,
	"id": "niftycarts",
	"version": "${version}",
	"name": "NiftyCarts",
	"description": "A Fabric Port of the AstikorCarts Minecraft mod. It adds carts for travel, shipping and farming.",
	"authors": [
		"MennoMax",
		"paul101",
		"jmb19905"
	],
    "contact": {
        "sources": "https://github.com/jmb05/nifty-carts",
        "homepage": "https://modrinth.com/mod/niftycarts",
        "issues": "https://github.com/jmb05/nifty-carts/issues"
    },
	"license": "MIT",
	"icon": "assets/niftycarts/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.jmb19905.niftycarts.NiftyCarts"
		],
		"client": [
          "net.jmb19905.niftycarts.client.NiftyCartsClient"
		], "fabric-datagen": [
		  "net.jmb19905.niftycarts.client.datagen.NiftyCartsDatagen"
		]
	},
	"mixins": [
		"niftycarts.mixins.json",
		{
			"config": "niftycarts.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.17.2",
		"minecraft": "~1.21.5",
		"java": ">=21",
		"fabric-api": "*",
		"forgeconfigapiport": ">=21.5.1"
	},
	"suggests": {
		"forgeconfigscreens": "*"
	},
	"accessWidener": "niftycarts.accesswidener"
}